# Firebase 웹 앱 설정. 이 값들은 비밀이 아니다 — 클라이언트 번들에 그대로
# 담겨 배포되고, Firebase 문서도 공개를 전제한다. 실제 접근 차단은
# firestore.rules 가 구글 서버에서 수행한다.
#
# 로컬에서는 이 파일을 .env.local 로 복사해 채우고, 배포는 Vercel 환경 변수에
# 같은 이름으로 넣는다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
