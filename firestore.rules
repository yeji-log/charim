rules_version = '2';

// 차림 접근 규칙.
//
// 여기가 실제 방어선이다. 화면에서 버튼을 숨기거나 탭을 감추는 것은 편의일 뿐이고,
// 브라우저 코드를 아무리 고쳐도 이 규칙을 우회할 수 없다.
//
// 두 가지를 계속 지킬 것:
//
//  1. 하위 컬렉션은 규칙을 상속받지 않는다. chunks 같은 서브컬렉션도 빠짐없이
//     따로 적어야 한다 — 빠뜨리면 그 아래가 무방비로 열린다.
//  2. 여기 적히지 않은 경로는 기본이 거부다. 단계가 진행되면서 컬렉션이 늘 때마다
//     이 파일에 함께 추가한다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{wsId} {

      // Google 로그인에 성공했다고 교사가 되는 것이 아니다.
      // members 에 자기 uid 문서가 있어야 한다. 문서는 콘솔에서 손으로 만든다.
      function isMember() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
      }

      // workspace 문서 자체는 아직 아무것도 담지 않는다. 하위 경로만 쓴다.
      allow read, write: if false;

      // 교사 명단: 로그인한 사람이 '자기 자신'의 등록 여부만 확인할 수 있다.
      //
      // list 를 막는 게 핵심이다. 문서 id 가 uid 라 그 자체는 개인정보가 아니지만
      // 안에 이메일이 들어 있고, 목록을 열면 학교 교사 전원의 이메일이 샌다.
      // 추가·삭제는 Firebase 콘솔에서만 한다 — 초대제라 자동 가입이 없다.
      match /members/{uid} {
        allow get: if request.auth != null && uid == request.auth.uid;
        allow list, create, update, delete: if false;
      }

      // 교사 공개 페이지 (/t/{slug}). 학생은 로그인이 없으므로 읽기는 열어둔다.
      //
      // 이 컬렉션을 members 와 따로 두는 이유가 바로 위의 list 차단이다. 학생이
      // "kim" 이라는 주소로 교사를 찾으려면 어딘가는 공개 읽기여야 하는데,
      // members 를 열 수는 없으니 공개해도 되는 것(uid·표시 이름)만 담은 문서를
      // 따로 만든다. 그러므로 여기에 이메일을 넣으면 안 된다.
      //
      // 아래 두 줄이 슬러그 중복 방지 장치이기도 하다. 문서 id 가 곧 슬러그라,
      // 남이 이미 쓰는 슬러그로 저장을 시도하면 create 가 아니라 update 로
      // 분류되어 두 번째 줄에서 막힌다. 클라이언트 중복 검사는 두 교사가 동시에
      // 저장할 때 둘 다 통과하므로 쓰지 않는다.
      // 반 — 학생 학번·이름이 들어가는 곳이라 가장 좁게 막는다.
      //
      // isMember() 만으로 열지 않는다. 같은 학교라도 남의 학년 학생 명단까지
      // 다 보이는 건 과하다는 판단이다(사용자 결정). 그 반의 담당 교사여야 한다.
      //
      // teacherUids 가 단수 소유자가 아니라 목록인 이유는 한 반에 국어·수학·
      // 영어 교사가 함께 들어가기 때문이다. 명단을 한 명이 만들면 나머지가
      // 그대로 쓴다.
      //
      // 목록 조회는 규칙이 대신 걸러주지 않는다 — 조건에 맞지 않는 문서가
      // 하나라도 결과에 들어가면 질의 전체가 거부될 뿐이다. 그래서 화면 쪽
      // 질의에 array-contains 제약이 반드시 들어가야 한다(classRecords.ts 의
      // listClasses 참고).
      function isClassTeacher(classId) {
        return isMember()
          && request.auth.uid in
             get(/databases/$(database)/documents/workspaces/$(wsId)/classes/$(classId))
               .data.teacherUids;
      }

      match /classes/{classId} {
        allow read: if isMember() && request.auth.uid in resource.data.teacherUids;
        allow create: if isMember() && request.auth.uid in request.resource.data.teacherUids;
        allow update, delete: if isMember() && request.auth.uid in resource.data.teacherUids;

        // 규칙은 하위 컬렉션으로 상속되지 않는다. 빠뜨리면 학생 명단이 무방비로
        // 열린다. 부모 문서를 get() 해서 담당인지 다시 확인한다.
        match /students/{studentId} {
          allow read, write: if isClassTeacher(classId);
        }

        // 참여 기록은 교사마다 따로 둔다. 같은 반이어도 교사마다 다른 시간에
        // 다른 걸 기록하므로 한 곳에 섞으면 안 된다(사용자 결정).
        // 자기 uid 아래만 읽고 쓴다 — 남의 기록은 담당이 같아도 못 본다.
        match /records/{uid}/dates/{dateId} {
          allow read, write: if isMember() && uid == request.auth.uid;
        }
      }

      // 시간표는 교사마다 문서가 다르다 — 문서 id 가 uid 다.
      //
      // 학생이 볼 이유가 없는 교사 업무 정보(반 이름, 교실)라 읽기까지 막는다.
      // 과목·자료의 핀처럼 "가벼운 잠금"이 아니라 진짜 차단이다.
      //
      // 읽기를 isMember() 로만 열어 동료 교사끼리는 서로의 시간표를 볼 수 있게
      // 했다. 같은 학교에서 누가 언제 어느 교실에 있는지는 업무상 공유해도
      // 되는 정보이고, 오히려 교실이 겹치는지 확인할 때 쓸모가 있다. 쓰기는
      // 본인 문서만 — 남의 시간표를 고칠 수는 없다.
      match /timetables/{uid} {
        allow read: if isMember();
        allow write: if isMember() && uid == request.auth.uid;
      }

      match /teacherPages/{slug} {
        allow read: if true;
        allow create: if isMember()
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isMember()
          && resource.data.uid == request.auth.uid;
      }
    }
  }
}
